# Loki Configuration & API Keys

# Provider selection: "nvidia", "mock", "gemini/gemini-2.5-flash", "openai/gpt-4o-mini", "anthropic/claude-3-5-sonnet", or "ollama/llama3.1"
LOKI_PROVIDER=mock
LOKI_MODEL=mock-agent-v1
LOKI_TEMPERATURE=0.2
LOKI_MAX_STEPS=25
# Adaptive follow-up cycles when an information-finding task remains unresolved (0-20)
# Default 16 lets Loki explore a broader set of distinct methods before final synthesis.
LOKI_MAX_ADAPTIVE_CONTINUATIONS=16
LOKI_TIMEOUT=60.0

# NVIDIA NIM (NVIDIA Inference Microservices) - Hosted or Self-Hosted
NVIDIA_NIM_API_KEY=nvapi-your-key-here
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_NIM_RETRY_ATTEMPTS=3

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI / OpenAI-compatible API
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# Local Ollama endpoint
OLLAMA_BASE_URL=http://localhost:11434/v1

# Security & Sandboxing
LOKI_ENABLE_SHELL=true
# Docker image used for isolated shell commands (default remains minimal Alpine)
LOKI_SHELL_DOCKER_IMAGE=alpine:latest

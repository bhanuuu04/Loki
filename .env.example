# Loki Configuration & API Keys

# Provider selection: "mock", "gemini/gemini-2.5-flash", "openai/gpt-4o-mini", "anthropic/claude-3-5-sonnet", or "ollama/llama3.1"
LOKI_PROVIDER=mock
LOKI_MODEL=mock-agent-v1
LOKI_TEMPERATURE=0.2
LOKI_MAX_STEPS=10
LOKI_TIMEOUT=60.0

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI / OpenAI-compatible API
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# Local Ollama endpoint
OLLAMA_BASE_URL=http://localhost:11434/v1

# Security & Sandboxing
LOKI_ENABLE_SHELL=true
